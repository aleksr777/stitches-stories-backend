# Runtime
NODE_ENV='development'

# JWT (use independent random secrets of at least 32 characters)
JWT_ACCESS_SECRET='change_me_access_secret_at_least_32_chars'
JWT_REFRESH_SECRET='change_me_refresh_secret_at_least_32_chars'
JWT_ACCESS_EXPIRES_IN='15m'
JWT_REFRESH_EXPIRES_IN='7d'

# Verification code TTLs, in seconds
REGISTRATION_TOKEN_EXPIRES_IN=300
RESET_TOKEN_EXPIRES_IN=300
EMAIL_CHANGE_TOKEN_EXPIRES_IN=300
PASSWORD_CHANGE_TOKEN_EXPIRES_IN=300
VERIFICATION_CODE_RESEND_COOLDOWN=60
REGISTRATION_VERIFICATION_LOCKOUT=180
PASSWORD_RESET_VERIFICATION_LOCKOUT=180
EMAIL_CHANGE_VERIFICATION_LOCKOUT=180

# Login rate limiting
LOGIN_EMAIL_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW=300

# Public verification request rate limiting
PUBLIC_VERIFICATION_IP_MAX_REQUESTS=20
PUBLIC_VERIFICATION_IP_RATE_LIMIT_WINDOW=600

# General API rate limiting
AUTH_IP_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW=60
API_IP_MAX_REQUESTS=600
API_RATE_LIMIT_WINDOW=60
# Per authenticated session. Optional; defaults are used when omitted.
SESSION_API_MAX_REQUESTS=300
SESSION_API_RATE_LIMIT_WINDOW=60

# Redis
REDIS_HOST='127.0.0.1'
REDIS_PORT=16379
REDIS_TLS=false
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_CONNECT_TIMEOUT_MS=5000

# Application
SERVER_PORT=5174
FRONTEND_URL='http://localhost:5173'

# SBP / Robokassa. Disabled until your payment account is configured; see docs/SBP.md.
PAYMENTS_ENABLED=false
PAYMENTS_ACTIVE_ACCOUNT=''
ROBOKASSA_ACCOUNTS_JSON='[]'

# HTTP / cookie security
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE='lax'
TRUST_PROXY='false'

# PostgreSQL / TypeORM
DB_TYPE='postgres'
DB_HOST='127.0.0.1'
DB_PORT=15432
DB_NAME='stitches_stories'
DB_USERNAME='postgres'
DB_PASSWORD='local_development_only'
DB_TYPEORM_SYNC=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Session and security-event retention
SESSION_MAX_ACTIVE=10
SESSION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180

# SMTP
SMTP_HOST='127.0.0.1'
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=''
SMTP_FROM='studio@stitches.test'
SMTP_PASS=''
# Docker Mailpit ports are independent from external SMTP (for example Yandex).
MAILPIT_SMTP_PORT=11025
MAILPIT_WEB_PORT=18025

# Initial administrator migration only
INITIAL_ADMIN_EMAIL='owner@stitches.test'
INITIAL_ADMIN_PASSWORD='change_me_generated_by_setup'
INITIAL_ADMIN_NICKNAME='owner'
